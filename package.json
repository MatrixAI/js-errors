{
  "name": "@matrixai/errors",
  "version": "3.0.0",
  "author": "Roger Qiu",
  "description": "Exception System",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatrixAI/js-errors.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "!dist/tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": "./dist/*"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
    "prepare": "tsc -p ./tsconfig.build.json",
    "prepack": "npm run build",
    "build": "shx rm -rf ./dist && tsc -p ./tsconfig.build.json",
    "postversion": "npm install --package-lock-only --ignore-scripts --silent",
    "tsx": "tsx",
    "test": "node ./scripts/test.mjs",
    "typecheck": "tsc -p ./tsconfig.json",
    "lint": "matrixai-lint --eslint-config ./eslint.config.mjs",
    "lintfix": "matrixai-lint --fix --eslint-config ./eslint.config.mjs",
    "check:package": "npm run build && node ./scripts/check-package.mjs",
    "test:browser": "npm run check:package && node ./tests/browser/runtime.mjs",
    "check": "npm run typecheck && npm test -- --runInBand && npm run lint && npm run check:package"
  },
  "dependencies": {
    "ts-custom-error": "3.2.2"
  },
  "devDependencies": {
    "@matrixai/lint": "github:MatrixAI/js-lint#v1.0.1",
    "@playwright/test": "1.59.1",
    "@swc/core": "1.3.82",
    "@swc/jest": "^0.2.29",
    "@types/jest": "^29.5.2",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "jest": "^29.6.2",
    "jest-extended": "^4.0.0",
    "jest-junit": "^16.0.0",
    "shx": "^0.3.4",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3"
  }
}
